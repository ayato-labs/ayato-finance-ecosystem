{
  "name": "portfolio-rebalancer",
  "private": true,
  "version": "1.0.0",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder",
    "electron:package": "npm run build && electron-packager . Alloc --platform=win32 --arch=x64 --out=dist_package --overwrite --ignore=src --ignore=tests --ignore=pyproject.toml --ignore=uv.lock"
  },
  "build": {
    "appId": "com.alloc.rebalancer",
    "productName": "Alloc",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "portable",
      "icon": "public/vite.svg"
    }
  },
  "dependencies": {
    "eslint": "^10.3.0",
    "lucide-react": "^0.395.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.0.0-alpha.16",
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "electron-packager": "^17.1.2",
    "jsdom": "^24.1.0",
    "tailwindcss": "^4.0.0-alpha.16",
    "typescript": "^5.5.2",
    "typescript-eslint": "^8.59.3",
    "vite": "^5.3.1",
    "vitest": "^1.6.0",
    "wait-on": "^9.0.10"
  }
}
